{
  "manifest_version": 3,
  "name": "Lightdash Licensing Advisor",
  "version": "1.0.0",
  "description": "Interactive questionnaire that guides content licensing decisions via Lightdash AI",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://*.lightdash.cloud/*", "http://localhost:*/*"],
      "js": ["decision-tree.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
